ANTHROPIC_API_KEY=your_api_key_here
PORT=3000

# Public base URL of the site. Used to build the result/report links in
# outgoing emails. In production set this (e.g. in Vercel) to the live domain.
APP_URL=https://roast.noturregularhr.com

# Supabase (analysis persistence) — project URL + service key, NOT the site domain.
# These do not change when the site domain changes.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_service_key

# Stripe — success/cancel URLs are derived from the request host automatically.
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_PRICE_ID=your_stripe_price_id
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret
